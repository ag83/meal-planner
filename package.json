{
  "name": "meal-planner",
  "version": "0.1.0",
  "description": "Local-first recipe collection and tag-based search",
  "main": "./out/main/index.js",
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest",
    "postinstall": "electron-rebuild -f -w better-sqlite3,sharp",
    "pretest": "npm rebuild better-sqlite3",
    "posttest": "electron-rebuild -f -w better-sqlite3,sharp",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3,sharp"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "better-sqlite3": "^12.11.1",
    "electron-log": "^5.2.4",
    "js-yaml": "^4.2.0",
    "natural": "^8.1.1",
    "react-router-dom": "^7.18.0",
    "sharp": "^0.35.1",
    "tesseract.js": "^4.1.4"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/rebuild": "^3.7.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
